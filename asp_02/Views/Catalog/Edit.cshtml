@model asp_02.Models.Product

@{
    ViewData["Title"] = "Редагувати товар";
}

<div class="container my-5" style="max-width: 600px;">
    <h2 class="mb-4 font-weight-bold text-center">Редагувати товар</h2>

    <div class="card shadow-sm p-4 border-0">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Image" />

            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label font-weight-bold">Назва товару</label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CategoryId" class="form-label font-weight-bold">Категорія</label>
                <select asp-for="CategoryId" class="form-select form-control" asp-items="ViewBag.Categories" required></select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label font-weight-bold">Опис</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Price" class="form-label font-weight-bold">Ціна (грн)</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" required />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Amount" class="form-label font-weight-bold">Кількість (шт)</label>
                    <input asp-for="Amount" class="form-control" type="number" min="0" required />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-group mb-4">
                <label class="form-label font-weight-bold">Змінити фото товару (необов'язково)</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                <div class="mt-2">
                    <small class="text-muted">Поточне фото:</small><br />
                    <img src="@Model.Image" style="height: 80px; object-fit: cover;" class="rounded shadow-sm mt-1" />
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light">Скасувати</a>
                <button type="submit" class="btn btn-primary px-4">Оновити дані</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
