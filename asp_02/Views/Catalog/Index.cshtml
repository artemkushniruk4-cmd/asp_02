@model IEnumerable<asp_02.Models.Product>

@{
    ViewData["Title"] = "Каталог товарів";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="font-weight-bold mb-0">Каталог товарів</h1>
        <!-- Кнопка додавання -->
        <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">+ Додати товар</a>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0 position-relative">

                    <!-- Тег категорії зверху на зображенні -->
                    <span class="badge bg-secondary text-white position-absolute m-2 p-2" style="top:0; left:0; z-index:10;">
                        @item.Category?.Name
                    </span>

                    <img src="@item.Image" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">

                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title font-weight-bold text-dark">@item.Name</h5>
                            <p class="card-text text-muted small">@item.Description</p>
                        </div>

                        <div class="mt-3 border-top pt-3">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-success font-weight-bold h5 mb-0">@item.Price.ToString("F2") грн</span>
                                <span class="badge bg-primary text-white p-2">В наявності: @item.Amount шт.</span>
                            </div>

                            <!-- Кнопки дій -->
                            <div class="d-flex gap-2 justify-content-between">
                                @if (item.Amount > 0)
                                {
                                    <form asp-controller="Cart" asp-action="Add" asp-route-id="@item.Id" method="post" class="w-50">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success btn-sm w-100">Додати в кошик</button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary btn-sm w-50" disabled>Немає в наявності</button>
                                }

                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm w-50">Редагувати</a>

                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="w-50" onsubmit="return confirm('Ви впевнені, що хочете видалити цей товар?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">Видалити</button>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>
