@model IEnumerable<asp_02.Models.Product>

@{
    ViewData["Title"] = "Каталог товарів";
}

<div class="container my-5">
    <h1 class="text-center mb-5 font-weight-bold">Каталог товарів</h1>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <!-- 1. Зображення (image) -->
                    <img src="@item.Image" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">

                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <!-- 2. Назва (name) -->
                            <h5 class="card-title font-weight-bold text-dark">@item.Name</h5>

                            <!-- 3. Опис (description) -->
                            <p class="card-text text-muted small">@item.Description</p>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-3">
                            <!-- 4. Ціна (price) -->
                            <span class="text-success font-weight-bold h5 mb-0">@item.Price.ToString("F2") грн</span>

                            <!-- 5. Кількість (amount) -->
                            <span class="badge bg-primary text-white p-2">В наявності: @item.Amount шт.</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
